# Copia este fichero a .env y ajusta lo que necesites. NUNCA subas .env al repositorio.
# Las variables de entorno reales tienen prioridad sobre este fichero.

# Directorio de datos (base de datos SQLite, perfiles, registros, secretos). Por defecto ./data
# PI_SENTINEL_DATA_DIR=/var/lib/pi-sentinel

# Token de ntfy (solo si usas un servidor con autenticación). Alternativa: guardarlo desde la
# interfaz (Notificaciones), que lo almacena en data/secrets.json con permisos 0600.
# PI_SENTINEL_NTFY_TOKEN=

# Interfaz web. Por defecto SOLO escucha en 127.0.0.1.
# Para abrirla a tu red local hay que habilitarlo explícitamente Y haber definido una contraseña
# (python -m app.main set-password).
# PI_SENTINEL_HOST=127.0.0.1
# PI_SENTINEL_PORT=8765
# PI_SENTINEL_ALLOW_LAN=0
# Hosts adicionales aceptados en la cabecera Host (separados por comas), p. ej. el nombre mDNS:
# PI_SENTINEL_ALLOWED_HOSTS=raspberrypi.local
# TLS directo (opcional; lo habitual es un proxy inverso):
# PI_SENTINEL_TLS_CERT=/ruta/cert.pem
# PI_SENTINEL_TLS_KEY=/ruta/key.pem

# Directorio de modelos ONNX (por defecto ./models)
# PI_SENTINEL_MODELS_DIR=
LOG_LEVEL=INFO
